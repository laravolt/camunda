{
    "name": "laravolt/camunda",
    "description": "High level model, something like Eloquent, to interact with Camunda resources via REST API",
    "keywords": ["laravel", "laravolt", "camunda"],
    "homepage": "https://github.com/laravolt/camunda",
    "license": "MIT",
    "authors": [
        {
            "name": "Bayu Hendra Winata",
            "email": "uyab.exe@gmail.com",
            "homepage": "https://laravolt.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-simplexml": "*",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-data": "^4.23"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.5|^13.4"
    },
    "autoload": {
        "psr-4": {
            "Laravolt\\Camunda\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laravolt\\Camunda\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --exclude-group integration",
        "test:integration": "phpunit --group integration"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.x-dev"
        },
        "laravel": {
            "providers": [
                "Laravolt\\Camunda\\ServiceProvider"
            ]
        }
    }
}
